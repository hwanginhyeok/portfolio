    "image_file_name": "https://daoift3qrrnil.cloudfront.net/company_groups/images/000/015/991/webp/jss_hashed_3c4d2a12691e27c962ba_20261016T144832_%E1%84%8B%E1%85%B2%E1%84%82%E1%85%B5%E1%84%89%E1%85%B3%E1%84%90%E1%85%B3%E1%84%80%E1%85%B5%E1%84%89%E1%85%AE%E1%86%AF%E1%84%8C%E1%85%B5%E1%84%8C%E1%85%AE_%E1%84%85%E1%85%A9%E1%84%80%E1%85%A92.webp?1792129712",
