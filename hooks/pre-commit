#!/bin/sh
# Rebuild site/index.html from features/ and ops/ops.yaml before commit.
set -e

ROOT="$(git rev-parse --show-toplevel)"
if [ -f "$ROOT/.venv/bin/python" ] && "$ROOT/.venv/bin/python" -c "import yaml" 2>/dev/null; then
  "$ROOT/.venv/bin/python" "$ROOT/scripts/generate_site.py" >/dev/null
elif command -v uv >/dev/null 2>&1; then
  uv run --with pyyaml python3 "$ROOT/scripts/generate_site.py" >/dev/null
else
  python3 "$ROOT/scripts/generate_site.py" >/dev/null
fi

if ! git diff --quiet -- site/index.html || ! git diff --cached --quiet -- site/index.html; then
  git add site/index.html
  echo "pre-commit: rebuilt and staged site/index.html"
fi
