<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  hih.portfolio.jasoseol-calendar — Daily Jasoseol application deadlines sync to Google Calendar, 08:34 Asia/Seoul.

  DRAFT ONLY: NOT INSTALLED / NOT LOADED by the migration.
  To be installed on macOS by PM upon operational cutover:

      cp launchd/hih.portfolio.jasoseol-calendar.plist ~/Library/LaunchAgents/
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/hih.portfolio.jasoseol-calendar.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>hih.portfolio.jasoseol-calendar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd ~/Workspace/projects/portfolio &amp;&amp; exec uv run python3 scripts/jasoseol_calendar.py --apply</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>34</integer>
    </dict>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>/Users/hwang-inhyeok/Library/Logs/hih/portfolio_jasoseol_calendar.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hwang-inhyeok/Library/Logs/hih/portfolio_jasoseol_calendar.log</string>
</dict>
</plist>
