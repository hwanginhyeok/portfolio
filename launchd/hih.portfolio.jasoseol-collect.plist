<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  hih.portfolio.jasoseol-collect — Daily Jasoseol recruitment calendar crawl, 08:30 Asia/Seoul.

  macOS LaunchAgent for the portfolio jobs. Absolute paths only: a home
  shorthand anywhere in a plist makes launchd fail the spawn with EX_CONFIG.

  Installed and loaded on the Mac; moved from the server-pc cron line on
  2026-09-29 (t34, infra mac.yaml). Install / reload:

      cp launchd/hih.portfolio.jasoseol-collect.plist $HOME/Library/LaunchAgents/
      launchctl bootstrap gui/$(id -u) $HOME/Library/LaunchAgents/hih.portfolio.jasoseol-collect.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>hih.portfolio.jasoseol-collect</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/hwang-inhyeok/Workspace/projects/portfolio/.venv/bin/python</string>
        <string>/Users/hwang-inhyeok/Workspace/projects/portfolio/scripts/jasoseol_collect.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/hwang-inhyeok/Workspace/projects/portfolio</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>/Users/hwang-inhyeok/Library/Logs/hih/portfolio_jasoseol_collect.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hwang-inhyeok/Library/Logs/hih/portfolio_jasoseol_collect.log</string>
</dict>
</plist>
