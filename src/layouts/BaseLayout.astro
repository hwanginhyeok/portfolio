---
interface Props {
  title: string;
  description?: string;
}

// 변경 2026-04-26: PM 톤 통일 — "PM" → "주니어 PM" (사용자 지시)
const { title, description = '분야를 가리지 않는 엔지니어 — HW·FW·SW·주니어 PM 경계 없이 제품을 만드는 사람' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <!-- Nav N2: T1~T5 직접 노출, 모바일 햄버거 -->
    <nav class="fixed top-0 w-full bg-primary/95 backdrop-blur-sm z-40 border-b border-white/10">
      <div class="max-w-5xl mx-auto px-6 flex items-center justify-between h-14">
        <a href={base} class="text-white font-bold text-sm tracking-tight">황인혁</a>
        <div class="hidden md:flex items-center gap-6 text-sm">
          <a href={`${base}#t1-dfmea`} class="text-gray-300 hover:text-white transition-colors duration-150">현장 설계</a>
          <a href={`${base}#t2-test`} class="text-gray-300 hover:text-white transition-colors duration-150">시험 증명</a>
          <a href={`${base}#t3-system`} class="text-gray-300 hover:text-white transition-colors duration-150">시스템</a>
          <a href={`${base}#t4-apqp`} class="text-gray-300 hover:text-white transition-colors duration-150">양산 체계</a>
          <a href={`${base}#t5-roots`} class="text-gray-300 hover:text-white transition-colors duration-150">엔지니어의 뿌리</a>
          <a href="https://github.com/hwanginhyeok" target="_blank" rel="noopener" class="text-accent hover:text-white transition-colors duration-150">GitHub</a>
        </div>
        <button id="nav-toggle" class="md:hidden text-gray-300 hover:text-white p-1" aria-label="메뉴 열기">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
      <div id="nav-menu" class="hidden md:hidden bg-primary border-t border-white/10 px-6 py-4 space-y-3">
        <a href={`${base}#t1-dfmea`} class="block text-sm text-gray-300 hover:text-white">T1 — 현장에서 돌아오는 설계</a>
        <a href={`${base}#t2-test`} class="block text-sm text-gray-300 hover:text-white">T2 — 기획에서 양산까지</a>
        <a href={`${base}#t3-system`} class="block text-sm text-gray-300 hover:text-white">T3 — 시스템 아키텍처</a>
        <a href={`${base}#t4-apqp`} class="block text-sm text-gray-300 hover:text-white">T4 — 양산 체계</a>
        <a href={`${base}#t5-roots`} class="block text-sm text-gray-300 hover:text-white">T5 — 엔지니어의 뿌리</a>
        <a href="https://github.com/hwanginhyeok" target="_blank" rel="noopener" class="block text-sm text-accent hover:text-white">GitHub</a>
      </div>
    </nav>
    <slot />

    <!-- Lightbox -->
    <div id="lightbox" class="fixed inset-0 z-50 bg-black/80 hidden items-center justify-center p-4 cursor-zoom-out" onclick="this.classList.add('hidden');this.classList.remove('flex')">
      <img id="lightbox-img" class="max-w-full max-h-[90vh] rounded-lg shadow-2xl" />
    </div>
    <script is:inline>
      document.addEventListener('click', (e) => {
        const img = e.target.closest('figure img');
        if (!img) return;
        const lb = document.getElementById('lightbox');
        document.getElementById('lightbox-img').src = img.src;
        lb.classList.remove('hidden');
        lb.classList.add('flex');
      });
      const toggle = document.getElementById('nav-toggle');
      const menu = document.getElementById('nav-menu');
      if (toggle && menu) {
        toggle.addEventListener('click', () => menu.classList.toggle('hidden'));
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
