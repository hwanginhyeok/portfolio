---
// T-4: 양산 체계 APQP
// SSOT: CONTENT_V2 §7B
const items = [
  { id: 'D-1', title: 'APQP Phase 2~3', detail: '5단계 중 2~3 직접 수행. 양산 16pcs + 대차/Spare 4' },
  { id: 'D-2', title: 'DFMEA Assembly 재편 + Boundary Diagram', detail: 'AIAG-VDA 정석 구조. FM 배치 규칙 수립 (C-134)' },
  { id: 'D-3', title: 'DFMEA #201/#210 Step 1~7 완료', detail: 'CBA/SYS DFMEA — AP=H 5건 도출 (C-135)' },
  { id: 'D-4', title: 'BOM 132항목 관리', detail: '재고 미확보 23건 식별 · PreMP V0.3.4' },
  { id: 'D-5', title: 'IQC 검사 가이드', detail: '구동모터 · 노즐 수입검사 기준 문서화 (C-83, C-84)' },
  { id: 'D-6', title: '양산 ROM 검토 체크리스트', detail: 'FW 양산 게이트 운영 (C-76)' },
  { id: 'D-7', title: '혁신제품 실사 4/9 대응', detail: '#205, 전력제어 공동대응 (C-125)' },
  { id: 'D-8', title: 'D-13 즉시 조치 4건', detail: '그리스/와셔/토크/방수캡 (C-124)' },
  // Added 2026-09-07 — April→September 2026 progress (HIH_2 FINISHED_TASK / CURRENT_TASK)
  { id: 'D-9', title: '양산 1호기 · 고객 시연 2회 Pass', detail: '5월 양산 1호기로 시연 2회 완료 (쌍구노즐 + Flow Plate). 알파 2호기 점검 병행 (C-174/C-185/C-192)' },
  { id: 'D-10', title: 'CAN ICD V0.3-r3 개정 — 산출물 8종 동기', detail: 'Excel↔FW 충돌은 FW 우선 원칙 확립. 메시지 ID 정정 · 신규 시그널 · faultCode 범례 · UART 36B payload (C-227)' },
  { id: 'D-11', title: 'DFMEA WP 정밀 분석 5건 (AP=H)', detail: 'BMS timeout · 후드 변형 · 자율주행 복귀 · 복합 현장 이슈 · 후가공 — 후속 태스크 12건 파생 (C-DFMEA)' },
  { id: 'D-12', title: 'PM 대시보드 + APQP 게이트 체크리스트', detail: '10패널 · DFMEA S×O 리스크 매트릭스 · AIAG 3판 G1~G5 GO/NO-GO — G3 78% · G4 71% (C-237)' },
  { id: 'D-13', title: '납품 호기 관제 · 방제 동행 회차 관리', detail: '납품 후 방제 지원 n/4회 타임라인, 호기 수명주기 상태 DB 분리 (C-303)' },
  { id: 'D-14', title: 'DVP&R 마스터 매트릭스 35항목', detail: '7 카테고리 · 완료 9 / 진행 4 / 미착수 22 / 차세대 이관 4 · 시험 담당 35/35 · DesignGoals 매핑 14 (2026-05)' },
];
---

<div class="rounded-lg overflow-hidden border border-ink-300">
  <table class="w-full text-sm">
    <thead class="bg-ink-50">
      <tr>
        <th class="text-left p-3 font-semibold text-ink-700 w-8">#</th>
        <th class="text-left p-3 font-semibold text-ink-700">활동</th>
        <th class="text-left p-3 font-semibold text-ink-700 hidden md:table-cell">내용</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-ink-100">
      {items.map((item) => (
        <tr class="hover:bg-ink-50/50 transition-colors">
          <td class="p-3 font-mono text-xs text-ink-500">{item.id}</td>
          <td class="p-3 font-medium text-primary">
            {item.title}
            <p class="md:hidden text-xs text-ink-500 font-normal mt-0.5">{item.detail}</p>
          </td>
          <td class="p-3 text-ink-700 hidden md:table-cell">{item.detail}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
