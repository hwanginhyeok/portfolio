---
// 변경 2026-04-26: 경력 최신순으로 정렬 (사용자 지시) — 선임 → 주임 → 석사 → 학부
import SectionHead from './SectionHead.astro';
const timeline = [
  {
    period: '2025.01 —',
    // 변경 2026-04-26: PM 톤 통일 — "(PM)" → "(주니어 PM)" (사용자 지시)
    title: 'GINT 전력제어개발팀 + 제품개발팀(주니어 PM)',
    role: '선임연구원',
    // Updated 2026-09-07: April–September 2026 progress
    detail: 'GT-SS500 전력설계 통합 · 양산 1호기 · 고객 시연 4회(3 Pass 1 Fail → 재검증) · MBD 파이프라인(전력 흐름·PID·FW 재구현 모델) · CAN ICD V0.3-r3 · DFMEA WP 5건 · 호기 관제 데이터 파이프라인 + Fleet Ops',
    tools: 'STM32 · CAN-FD · Python · python-control · Notion/Slack 자동화 · Claude Code',
  },
  {
    period: '2023.02 — 2024.12',
    title: 'GINT 전력제어개발팀',
    role: '주임연구원',
    detail: '다이나모 벤치 구축 · SCU(현대/DIC) BLDC 제어 · EOP 400W 국책과제 · 특허 2건 출원',
    tools: 'C · NXP MCU · CAN · FOC/SVPWM',
  },
  {
    period: '2021 — 2023',
    title: '대학원 석사',
    role: '석사과정',
    // 변경 2026-04-26 (2nd): U-4 정직 옵션 — PAPERS.md SSOT (공저 저널 3 + 학회 4 + 수상 2)
    detail: '120kW 모터 모델링 · 고장진단(PHM) · 현대차·현대엔지비·산자부 과제 3건 · 공저 저널 3편(IEEE TIM·Solar Energy·J.Power Electron.) · 학회 4편 (수상 2)',
    tools: 'Matlab · Simulink · Ansys MAXWELL',
  },
  {
    period: '2015 — 2021',
    title: '기계공학부 기계설계학과',
    role: '학부',
    detail: '',
  },
];
---

<section class="py-12 border-t border-ink-100">
  <SectionHead tag="CV" label="경력" tone="ink" title="경력" thesis="최신순 — 선임연구원 · 주임연구원 · 석사 · 학부." />

  <div class="relative">
    <!-- 세로 라인 -->
    <div class="absolute left-4 md:left-6 top-0 bottom-0 w-0.5 bg-ink-300"></div>

    <div class="space-y-8">
      {timeline.map((item, i) => (
        <div class="relative pl-12 md:pl-16">
          <!-- 도트: 변경 2026-04-26 — 최신순 정렬에 맞춰 첫 항목(현재)에 accent -->
          <div class={`absolute left-2.5 md:left-4.5 w-3 h-3 rounded-full border-2 border-white ${i === 0 ? 'bg-accent' : 'bg-ink-500'}`}></div>

          <div class="text-xs text-muted mb-1">{item.period}</div>
          <h3 class="text-base font-bold text-primary">{item.title}</h3>
          <span class="text-xs bg-surface text-muted px-2 py-0.5 rounded-full">{item.role}</span>
          {item.detail && <p class="text-sm text-ink-700 mt-2">{item.detail}</p>}
          {item.tools && <p class="text-xs text-muted mt-1">{item.tools}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
