---
// T-2: 성능 개선 3건 — 기획→개발→시험→양산 흐름
// SSOT: CONTENT_V2 §7.3
const cases = [
  {
    id: 'B-1',
    title: '팬 성능',
    metric: '+57%',
    metricLabel: '풍속 7.9→12.4 m/s',
    plan: 'REQ-FAN 36건 요구조건서 작성 (C-61)',
    dev: '20파이 프로펠러 변경 + 팬 제어 로직 설계',
    prove: '팬 벤치 직접 구축 → 풍속 7.9→12.4 m/s (+57%)',
    prod: 'SS500 양산 사양 확정 · SS1000 POC Option A 피드백',
  },
  {
    id: 'B-2',
    title: '분사 성능',
    metric: '명판 허위',
    metricLabel: '32~50 LPM 허위 확정',
    plan: '아세아텍 100A 기성 벤치마크 — "유량 4배 부족을 메울 수 있는가?"',
    dev: '전력 역산: 펌프 수동력 1.65kW → 모터 입력 3.23kW → 필요 전류 64A · 트레이드오프 정량화 (비용 3배, 운전시간 반감)',
    prove: '효율 비교 V2.0 — 신규 펌프 명판 32~50LPM 허위 확정',
    prod: '현 구성 유지 + 노즐/유로 최적화 · 공급망 검증 프로세스 수립',
  },
  {
    id: 'B-3',
    title: '구동 안전',
    metric: '0.082m',
    metricLabel: '정지거리 (3km/h)',
    plan: '자율주행 안전 요건 — 장애물 접촉 시 안전 정지',
    dev: '범퍼 접촉 센싱 → 모터 제어 연계 설계 · 범퍼 시험대 직접 구축',
    prove: '정지거리 0.082m · 상전류 피크 308A · 정착시간 467ms',
    prod: 'Main Relay 소손 대응 → VCU 정지 후 5분 MR 차단 안전 시퀀스 재설계',
  },
];
---

<div class="grid md:grid-cols-3 gap-4">
  {cases.map((c) => (
    <div class="rounded-lg border border-ink-300 bg-white overflow-hidden">
      <div class="bg-ink-50 px-5 py-4 border-b border-ink-300">
        <span class="text-xs font-mono text-ink-500">{c.id}</span>
        <div class="flex items-baseline gap-2 mt-0.5">
          <span class="text-2xl font-black text-accent">{c.metric}</span>
          <span class="text-xs text-ink-500">{c.metricLabel}</span>
        </div>
        <h4 class="font-bold text-primary mt-1">{c.title}</h4>
      </div>
      <div class="px-5 py-4 space-y-3 text-sm">
        <div>
          <span class="text-xs font-semibold text-ink-500 uppercase tracking-wide">기획</span>
          <p class="text-ink-700 mt-0.5">{c.plan}</p>
        </div>
        <div>
          <span class="text-xs font-semibold text-ink-500 uppercase tracking-wide">개발·분석</span>
          <p class="text-ink-700 mt-0.5">{c.dev}</p>
        </div>
        <div>
          <span class="text-xs font-semibold text-success uppercase tracking-wide">시험 증명</span>
          <p class="text-ink-700 mt-0.5">{c.prove}</p>
        </div>
        <div>
          <span class="text-xs font-semibold text-ink-500 uppercase tracking-wide">양산 반영</span>
          <p class="text-ink-700 mt-0.5">{c.prod}</p>
        </div>
      </div>
    </div>
  ))}
</div>
