---
// CAN 5노드 메시지 흐름 다이어그램 (GT-SS500)
// SSOT: src/pages/cases/ss500-state-machine/index.astro 표 + CONTENT_V2 §4.1/§7A.2
// 노드: VCU(중앙) + BMS / 구동 MC ×2 / 팬 ESC / 펌프 DRV / ADT PC
---

<div class="border rounded-xl p-4 md:p-5 bg-white overflow-x-auto">
  <!-- 상단: VCU -->
  <div class="flex justify-center">
    <div class="bg-primary text-white rounded-lg px-5 py-2.5 text-center shadow-md border-2 border-accent">
      <div class="font-bold text-sm">VCU</div>
      <div class="text-[10px] text-gray-300">STM32F479 · 마스터</div>
    </div>
  </div>

  <!-- CAN Bus -->
  <div class="relative my-3 mx-2 md:mx-6">
    <div class="h-1 bg-accent rounded-full"></div>
    <span class="absolute -top-2 left-1/2 -translate-x-1/2 bg-white px-2 text-[10px] font-bold text-accent">CAN Bus 500kbps · 5 nodes</span>
  </div>

  <!-- 5 노드: 각 노드는 Tx/Rx 양방향 표시 -->
  <div class="grid grid-cols-1 md:grid-cols-5 gap-2.5">
    <!-- BMS -->
    <div class="can-msg-node border-red-500">
      <div class="node-head"><span class="dot bg-red-500"></span><span class="text-red-700">BMS</span></div>
      <div class="node-sub">48V 460Ah</div>
      <div class="msg-tx">↑ SOC · 셀×15 · Fault</div>
      <div class="msg-rx">↓ Shutdown</div>
    </div>

    <!-- 구동 MC ×2 -->
    <div class="can-msg-node border-green-500">
      <div class="node-head"><span class="dot bg-green-500"></span><span class="text-green-700">구동 MC ×2</span></div>
      <div class="node-sub">DMKE · CANopen</div>
      <div class="msg-tx">↑ 속도 · 전류 · 상태</div>
      <div class="msg-rx">↓ 속도 지령 · 방향</div>
    </div>

    <!-- 팬 ESC -->
    <div class="can-msg-node border-amber-500">
      <div class="node-head"><span class="dot bg-amber-500"></span><span class="text-amber-700">팬 ESC</span></div>
      <div class="node-sub">Hobbywing · 29bit</div>
      <div class="msg-tx">↑ RPM · 온도</div>
      <div class="msg-rx">↓ RPM (3단)</div>
    </div>

    <!-- 펌프 DRV -->
    <div class="can-msg-node border-purple-500">
      <div class="node-head"><span class="dot bg-purple-500"></span><span class="text-purple-700">펌프 DRV</span></div>
      <div class="node-sub">48V DC</div>
      <div class="msg-tx">↑ 압력 · 유량</div>
      <div class="msg-rx">↓ 구동 지령</div>
    </div>

    <!-- ADT PC -->
    <div class="can-msg-node border-orange-500">
      <div class="node-head"><span class="dot bg-orange-500"></span><span class="text-orange-700">ADT PC</span></div>
      <div class="node-sub">자율주행</div>
      <div class="msg-tx">↑ 경로 · 목표속도 · 모드</div>
      <div class="msg-rx">↓ 차량상태 · SOC · Fault</div>
    </div>
  </div>

  <!-- 범례 -->
  <div class="flex flex-wrap items-center gap-3 mt-3 pt-3 border-t border-dashed border-gray-200 text-[10px] text-muted">
    <span class="font-bold text-gray-600">범례:</span>
    <span><span class="text-green-600 font-bold">↑</span> Tx (노드→VCU)</span>
    <span><span class="text-blue-600 font-bold">↓</span> Rx (VCU→노드)</span>
    <span class="ml-auto">DBC Factor/Offset · Little/Big Endian · CANopen + Extended 29bit 혼용</span>
  </div>
</div>

<style>
  .can-msg-node {
    border-left-width: 3px;
    @apply rounded-lg bg-gray-50 p-2.5;
  }
  .node-head {
    @apply text-xs font-bold flex items-center gap-1.5 mb-0.5;
  }
  .dot {
    @apply inline-block w-2 h-2 rounded-full;
  }
  .node-sub {
    @apply text-[10px] text-muted mb-2;
  }
  .msg-tx {
    @apply text-[10px] text-green-700 leading-snug;
  }
  .msg-rx {
    @apply text-[10px] text-blue-700 leading-snug mt-0.5;
  }
</style>
