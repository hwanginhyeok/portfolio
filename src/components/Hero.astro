---
// 히어로 v4: 전시회 제품 사진 추가 — 텍스트 좌 / 이미지 우
const base = import.meta.env.BASE_URL;
---

<section class="bg-primary text-white overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 py-20 md:py-28">
    <div class="grid md:grid-cols-5 gap-8 items-center">
      <!-- 좌: 텍스트 (3/5) -->
      <div class="md:col-span-3">
        {/* 변경 2026-04-26 (B3 LAYOUT): H-A + H-B 조합 — "스토리 흐름" 톤으로 재작성 (사용자 지시) */}
        <p class="text-sm tracking-widest text-gray-400 uppercase mb-4">Motor Control · Embedded HW · Junior PM</p>
        <h1 class="font-display text-3xl md:text-5xl font-black leading-tight mb-6">
          Full-stack Hardware<br />
          0&rarr;1 Builder &middot; AI-Augmented
        </h1>

        <p class="text-lg text-gray-300 max-w-xl mb-10">
          대학원에서 Sim2Real(IPMSM 디지털트윈)로 모터를 검증했고,<br class="hidden md:block" />
          회사에서 EOP &middot; GT-SS500 양산까지 끌고 갔습니다.<br class="hidden md:block" />
          다음은 로보틱스로 확장 중.
        </p>

        <div class="flex flex-wrap gap-x-8 gap-y-4 text-sm">
          {/* 변경 2026-04-26: "14건 전력제어 이슈 직접 담당" 제거 (사용자 지시) */}
          <div>
            <span class="text-2xl font-black text-white">-40°C</span>
            <span class="text-gray-400 ml-1">극저온 기동 300→100초</span>
          </div>
          <div>
            {/* 변경 2026-04-26 (2nd): U-4 정직 옵션 — PAPERS.md SSOT 기준 저널 3편(공저)·학회 4편 + 수상 2건 */}
            <span class="text-2xl font-black text-white">특허 2건</span>
            <span class="text-gray-400 ml-1">공동 1·기여 1 + 공저 저널 3편·학회 4편 (수상 2)</span>
          </div>
        </div>
      </div>

      <!-- 우: 제품 사진 (2/5) -->
      <div class="md:col-span-2 relative">
        <img
          src={`${base}images/hero/product-front.webp`}
          alt="PLUVA FRIEND GT-SS500 — 농업용 전동 자율주행 Speed Sprayer"
          class="rounded-lg shadow-2xl w-full object-cover"
          loading="eager"
          width="640"
          height="480"
        />
        <p class="text-xs text-gray-500 mt-2 text-center">PLUVA FRIEND GT-SS500</p>
      </div>
    </div>
  </div>
</section>
