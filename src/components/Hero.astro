---
// 히어로 v4: 전시회 제품 사진 추가 — 텍스트 좌 / 이미지 우
const base = import.meta.env.BASE_URL;
---

<section class="bg-primary text-white overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 py-20 md:py-28">
    <div class="grid md:grid-cols-5 gap-8 items-center">
      <!-- 좌: 텍스트 (3/5) -->
      <div class="md:col-span-3">
        <p class="text-sm tracking-widest text-gray-400 uppercase mb-4">전력제어 · 임베디드 HW · 주니어 PM</p>
        <h1 class="font-display text-3xl md:text-5xl font-black leading-tight mb-6">
          분야를 막론하고 —<br />
          문제가 있으면 해결한다
        </h1>

        <p class="text-lg text-gray-300 max-w-xl mb-10">
          코드·HW·기구·전력·SW. 경계 없이 엔지니어링 관점에서<br class="hidden md:block" />
          원인을 찾고, 시험으로 증명하고, 양산까지 끌고 간다.
        </p>

        <div class="flex flex-wrap gap-x-8 gap-y-4 text-sm">
          <div>
            <span class="text-2xl font-black text-white">-40°C</span>
            <span class="text-gray-400 ml-1">극저온 기동 300→100초</span>
          </div>
          <div>
            <span class="text-2xl font-black text-white">특허 2건</span>
            <span class="text-gray-400 ml-1">공동 1·기여 1 + 공저 저널 3편·학회 4편</span>
          </div>
          <div>
            <span class="text-2xl font-black text-white">16대</span>
            <span class="text-gray-400 ml-1">GT-SS500 · 0→1 풀사이클 완주</span>
          </div>
        </div>
      </div>

      <!-- 우: 제품 사진 (2/5) -->
      <div class="md:col-span-2 relative">
        <img
          src={`${base}images/hero/product-front.webp`}
          alt="PLUVA FRIEND GT-SS500 — 농업용 전동 자율주행 Speed Sprayer"
          class="rounded-lg shadow-2xl w-full object-cover"
          loading="eager"
          width="640"
          height="480"
        />
        <p class="text-xs text-muted mt-2 text-center">PLUVA FRIEND GT-SS500</p>
      </div>
    </div>
  </div>
</section>
