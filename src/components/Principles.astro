---
// "How I work" band — four principles, each anchored to something on this site.
// Added 2026-09-07 design pass. Dark band breaks the white rhythm before the timeline.
const base = import.meta.env.BASE_URL;
const items = [
  { n: '01', t: '장비가 없으면 만든다', d: '48 V 농기계용 시험장비는 시장에 없다. 다이나모·팬·펌프·범퍼·극저온 — 7종을 직접 설계했다.', href: `${base}cases/test-engineering/` },
  { n: '02', t: '측정 전에 모델이 먼저 답한다', d: '오실로를 대기 전에 범위를 예측한다. MBD가 MCB 100 A 대비 방제 137 A(여유 −37 A)를 짚었고, RS500 시뮬이 보호로직을 고장모드로 돌린다.', href: `${base}cases/ss500-mbd/` },
  { n: '03', t: '현장 실패는 설계로 돌아간다', d: 'MCB 탄화·상태머신·동파·GND 노이즈 — 근본원인까지 몰고 가 DFMEA에 적었다. NCR 27건 closed-loop.', href: `${base}#t1-dfmea` },
  { n: '04', t: '없는 건 없다고 쓴다', d: '특허 2건 중 1건은 발명자 명단에 없다. 시뮬-실차 36항목 중 일치는 15. 숫자는 실측만 적는다.', href: `${base}cases/patent/` },
];
---

<section class="bg-primary text-white">
  <div class="max-w-5xl mx-auto px-6 py-14">
    <p class="text-xs tracking-widest text-gray-400 uppercase mb-2">How I work</p>
    <h2 class="font-display text-2xl md:text-3xl font-black mb-8">네 가지 원칙 — 전부 이 사이트 어딘가에 증거가 있다</h2>
    <div class="grid md:grid-cols-2 gap-4">
      {items.map((it) => (
        <a href={it.href} class="group block rounded-lg border border-white/10 bg-white/5 p-5 hover:bg-white/10 hover:border-accent/60 transition-colors">
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-xs text-accent-dark">{it.n}</span>
            <h3 class="font-bold text-lg group-hover:text-white">{it.t}</h3>
          </div>
          <p class="text-sm text-gray-300 mt-2 leading-relaxed">{it.d}</p>
          <span class="inline-block mt-3 text-xs text-accent-dark underline underline-offset-4 decoration-white/30">근거 보기 →</span>
        </a>
      ))}
    </div>
  </div>
</section>
