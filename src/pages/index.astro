---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LifecycleHeatmap from '../components/LifecycleHeatmap.astro';
import DFMEAField from '../components/DFMEAField.astro';
import PerformanceFlow from '../components/PerformanceFlow.astro';
import TestProcess from '../components/TestProcess.astro';
import CanNetworkDiagram from '../components/CanNetworkDiagram.astro';
import NextGen from '../components/NextGen.astro';
import APQPSystem from '../components/APQPSystem.astro';
import AINative from '../components/AINative.astro';
import Timeline from '../components/Timeline.astro';
import SectionHead from '../components/SectionHead.astro';
import StatStrip from '../components/StatStrip.astro';
import Principles from '../components/Principles.astro';
import MbdPipeline from '../components/MbdPipeline.astro';
import TestGallery from '../components/TestGallery.astro';
const base = import.meta.env.BASE_URL;

const skills = [
  'BLDC/PMSM 모터제어', 'FOC/SVPWM', 'CAN/CAN-FD',
  'STM32 · NXP MCU', 'DFMEA/DRBFM · APQP',
  'Ansys Maxwell · Co-simulation', 'HIL',
  'PHM · multi-sensor fusion',
  'RTK GNSS · IMU 융합',
  'Python', 'C/C++', 'Matlab/Simulink',
  'ROS2 · Gazebo · Nav2', 'Dual-EKF · Pure Pursuit',
  'pytest · GitHub Actions CI', 'Linux',
  'Git', 'Claude Code',
];
---

<BaseLayout title="황인혁 — 분야를 막론하고 문제가 있으면 해결한다">

  <!-- #hero: 10초 스캔 (nav 높이 56px 보정) -->
  <div id="hero" class="pt-14">
    <Hero />
  </div>
  <StatStrip />

  <main id="main" class="max-w-5xl mx-auto px-6">

    <!-- #lifecycle: Lifecycle Heatmap -->
    <section id="lifecycle" class="py-12 border-t border-ink-100 scroll-mt-16">
      <SectionHead tag="MAP" label="생애주기" tone="ink" title="제품 생애주기 × 프로젝트" thesis="어느 단계까지 직접 수행했는가 — 한눈에." />
      <LifecycleHeatmap />
    </section>

    <!-- #t1-dfmea: T-1 현장에서 돌아오는 설계 -->
    <section id="t1-dfmea" class="py-12 border-t border-ink-100 scroll-mt-16">
      <SectionHead tag="T1" label="현장 설계" tone="red" title="현장에서 돌아오는 설계" thesis="DFMEA는 문서가 아니다. 고장모드를 먼저 상상하고, 설계로 돌아가는 사고방식이다." note="현장에서 사고가 나기 전에 Boundary Diagram에서 그 고장을 잡는다. 실제 현장 이슈 6건 — 근본원인 → 설계변경 → 검증." />
      <DFMEAField />
      <div class="mt-4 text-right">
        <a href={`${base}cases/ss500-state-machine/`} class="text-sm text-accent hover:underline">상태머신 케이스 심화 →</a>
      </div>
    </section>

    <!-- #t2-test: T-2 기획에서 양산까지 -->
    <section id="t2-test" class="py-12 border-t border-ink-100 scroll-mt-16">
      <SectionHead tag="T2" label="시험 증명" tone="blue" title="기획에서 양산까지 — 시험으로 증명한다" thesis="시험은 몇 개 만들었는가가 아니다. 매번 어떻게 접근하는가가 역량이다." note="가설 → 장비 설계 → 데이터 → 결정. 장비가 없으면 만든다." />
      <PerformanceFlow />
      <TestGallery />
      <TestProcess />
      <div class="mt-4 text-right">
        <a href={`${base}cases/test-engineering/`} class="text-sm text-accent hover:underline">시험 엔지니어링 케이스 →</a>
      </div>
    </section>

    <!-- #t3-system: T-3 시스템 아키텍처 -->
    <section id="t3-system" class="py-12 border-t border-ink-100 scroll-mt-16">
      <SectionHead tag="T3" label="시스템" tone="green" title="시스템 아키텍처 — 통신이 깨지면 제품이 죽는다" thesis="Breaking Change 4건을 사전에 잡아낸 것은 체크리스트가 있었기 때문이다." note="CAN 5노드 + DBC 4종 + BusLoad 분석 · 단일 노드에서 분산 시스템으로 · 측정 전에 모델로 먼저." />
      <CanNetworkDiagram />

      <!-- physical counterpart of the diagram — added 2026-09-07 -->
      <div class="mt-4 grid md:grid-cols-3 gap-3">
        <figure class="relative overflow-hidden rounded-lg aspect-[4/3] bg-ink-100">
          <img src={`${base}images/cases/state-machine/control-box-external.webp`} alt="GT-SS500 전장함 — MCB, 모터 드라이버 3기, VCU 배치" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-3 pt-6 pb-2 text-[11px] text-white">전장함 — 다이어그램의 실물. MCB · 드라이버 ×3 · VCU</figcaption>
        </figure>
        <figure class="relative overflow-hidden rounded-lg aspect-[4/3] bg-ink-100">
          <img src={`${base}images/cases/battery/battery-pack-top.webp`} alt="48V LiFePO4 배터리 팩 상면 — 섀시 장착 상태" loading="lazy" class="absolute inset-0 w-full h-full object-cover object-center" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-3 pt-6 pb-2 text-[11px] text-white">48 V 460 Ah LiFePO4 팩 — BMS 노드</figcaption>
        </figure>
        <figure class="relative overflow-hidden rounded-lg aspect-[4/3] bg-ink-100">
          <img src={`${base}images/cases/state-machine/lcd-panel.webp`} alt="현장 LCD/HMI 박스 — IG/BAT 스위치와 7인치 화면" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-3 pt-6 pb-2 text-[11px] text-white">LCD/HMI — RC · LCD · ADT 3모드의 현장 입구</figcaption>
        </figure>
      </div>

      <!-- MBD card — added 2026-09-07 -->
      <a href={`${base}cases/ss500-mbd/`} class="mt-6 block card card-link card-accent card-accent-green">
        <p class="text-xs text-ink-500 mb-1">모델 기반 설계 · 2026.04~05</p>
        <h3 class="font-bold text-primary">SS500 MBD — 오실로스코프를 대기 전에 모델이 먼저 답한다</h3>
        <p class="text-sm text-ink-700 mt-2">BOM 검증 → 전력 흐름 → Traction PID → VCU FW 재구현 모델(MIL 상당) → 통합 시뮬 4종(CAN 고장 주입). MCB 100 A 대비 방제 연속 137 A(여유 −37 A), DCDC 마진 70.8 %를 측정 전에 정량화 — 실측 대조는 미결.</p>
        <div class="mt-4 hidden md:block"><MbdPipeline compact /></div>
        <span class="mt-3 inline-block text-xs text-accent">케이스 보기 →</span>
      </a>

      <NextGen />
    </section>

    <!-- #t4-apqp: T-4 양산 체계 -->
    <section id="t4-apqp" class="py-12 border-t border-ink-100 scroll-mt-16">
      <SectionHead tag="T4" label="양산 체계" tone="amber" title="양산 체계 — 양산은 문서로 굴러간다" thesis="DFMEA가 없으면 엔지니어의 직감이 사라졌을 때 품질이 무너진다." note="APQP Phase 2~3 직접 수행 · 양산 1호기 · 고객 시연 4회(3 Pass · 1 Fail → 재검증 Pass) · 납품 호기 관제." />
      <APQPSystem />

      <!-- Production validation card — added 2026-09-07 -->
      <a href={`${base}cases/production-validation/`} class="mt-6 block card card-link card-accent card-accent-amber">
        <div class="grid md:grid-cols-[1fr_auto] gap-4 items-start">
          <div>
            <p class="text-xs text-ink-500 mb-1">양산 검증 · 2026.02~09</p>
            <h3 class="font-bold text-primary">검증은 판정표를 먼저 쓰는 데서 시작한다</h3>
            <p class="text-sm text-ink-700 mt-2">DVP&R 35항목(완료 9 · 미착수 22를 그대로) · QC 5게이트 (제어함 FCT 12 · 완성차 EOL 17항목 검사표준서) · 시험 기록 6건 · 수직 패터네이터 지그 설계(V07, 전도 SF 0.69 → 1.98) · 과수원 인수 시험 15 h 4,500평 · 시연 실패 → 조치 → 재검증.</p>
            <span class="mt-3 inline-block text-xs text-accent">케이스 보기 →</span>
          </div>
          <div class="hidden md:flex flex-col gap-1.5 text-[11px] w-44">
            {['업체 출하검사','IQC 수입검사','LQC 공정검사','EOL 최종검사','OQC 출하검사'].map((g,i) => (
              <div class="flex items-center gap-2"><span class="w-4 h-4 rounded-full bg-amber-500 text-white text-[9px] font-bold flex items-center justify-center shrink-0">{i+1}</span><span class="text-ink-700">{g}</span></div>
            ))}
          </div>
        </div>
      </a>
    </section>

    <!-- #t5-roots: T-5 엔지니어의 뿌리 -->
    <section id="t5-roots" class="py-12 border-t border-ink-100 scroll-mt-16">
      <SectionHead tag="T5" label="뿌리" tone="violet" title="엔지니어의 뿌리" thesis="대학원에서 훈련한 “모델 → 시뮬레이션 → 실험 검증” 체질이 EOP 다이나모미터, SS500 시험체계, RS500 시뮬 스택까지 이어진다." />

      <div class="grid md:grid-cols-2 gap-4">
        <!-- EOP 400W -->
        <a href={`${base}cases/eop-400w/`} class="block card card-link card-accent card-accent-violet">
          <p class="text-xs text-ink-500 mb-1">모터제어 깊이</p>
          <h3 class="font-bold text-primary">EOP 400W</h3>
          <p class="text-sm text-ink-700 mt-2">SVPWM/DPWM 절환 · CAN Sleep/Wakeup · -40°C 기동 · 다이나모 0.008%</p>
          <span class="mt-3 inline-block text-xs text-accent">케이스 보기 →</span>
        </a>

        <!-- Patents -->
        <a href={`${base}cases/patent/`} class="block card card-link card-accent card-accent-violet">
          <p class="text-xs text-ink-500 mb-1">특허 참여 2건</p>
          <h3 class="font-bold text-primary">특허 — 정직한 기재</h3>
          <p class="text-sm text-ink-700 mt-2">공동 발명 1건 (초기위치 검출) · 개발 기여 1건 (저온 기동). 발명자 명단이 전부는 아니다.</p>
          <span class="mt-3 inline-block text-xs text-accent">케이스 보기 →</span>
        </a>

        <!-- Research -->
        <div class="card card-accent card-accent-violet">
          <p class="text-xs text-ink-500 mb-1">대학원 연구</p>
          <h3 class="font-bold text-primary">PHM · Co-simulation</h3>
          <p class="text-sm text-ink-700 mt-2">IPMSM 디지털트윈 · Ansys Maxwell(FEM) → MATLAB/Simulink → 실험 검증 · 공저 저널 3편 · 학회 4편 (수상 2)</p>
        </div>

        <!-- Autonomy stack (side project) — added 2026-09-07, the case the 2026-04 expert review asked for -->
        <a href={`${base}cases/autonomy-stack/`} class="block card card-link card-accent card-accent-violet">
          <p class="text-xs text-ink-500 mb-1">사이드 프로젝트 · Sim2Real</p>
          <h3 class="font-bold text-primary">RS500 자율주행 시뮬 스택</h3>
          <p class="text-sm text-ink-700 mt-2">SS500 실차 파라미터로 만든 물리 시뮬 + ROS2 7패키지 · 보호기능을 고장모드로 · 테스트 497개 CI · 실차 36항목 교차검증</p>
          <span class="mt-3 inline-block text-xs text-accent">케이스 보기 →</span>
        </a>

        <!-- AI-Native -->
        <AINative />
      </div>
    </section>

  </main>

  <!-- How I work — full-bleed band -->
  <Principles />

  <main class="max-w-5xl mx-auto px-6">
    <!-- #timeline: 경력 -->
    <div id="timeline" class="scroll-mt-16">
      <Timeline />
    </div>

    <!-- #about: About + 기술 스택 -->
    <section id="about" class="py-12 border-t border-ink-100 scroll-mt-16">
      <SectionHead tag="ABOUT" label="소개" tone="ink" title="About" thesis="전력제어개발팀 선임연구원 · 제품개발팀 주니어 PM 겸임 — 사이드 프로젝트와 기술 스택." />
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <div class="flex items-center gap-4 mb-4">
            <img src={`${base}images/about/profile.webp`} alt="황인혁" class="w-16 h-16 rounded-full object-cover border-2 border-ink-300" loading="lazy" />
            <div>
              <p class="font-bold text-primary">황인혁 (Inhyeok Hwang)</p>
              <p class="text-sm text-muted">전력제어개발팀 · 선임연구원</p>
            </div>
          </div>

          <h3 class="font-bold text-lg mb-2">현재</h3>
          <ul class="space-y-2 text-sm text-ink-700">
            <li><strong>전력제어개발팀 · 선임연구원</strong> — 모터제어, 전력설계, 시험검증</li>
            <li><strong>제품개발팀 · 주니어 PM 겸임</strong> — 이슈 37건+ 트래킹 (전력제어 담당 14건), BOM 132개 항목, APQP Phase 2~3</li>
            <li><strong>2026 진행</strong> — 양산 1호기 · 고객 시연 4회(3 Pass 1 Fail → 재검증 Pass) · MBD 5페이즈 · CAN ICD 개정 · 호기 관제 파이프라인 + Fleet Ops 사이트</li>
          </ul>

          <h3 class="font-bold text-lg mt-6 mb-2">학력</h3>
          <ul class="space-y-2 text-sm text-ink-700">
            <li><strong>석사</strong> — 모터 모델링/고장진단(PHM), 공저 저널 3편 · 학회 4편 (수상 2건)</li>
            <li><strong>학부</strong> — 기계공학부 · 기계설계학과 (학·석사)</li>
          </ul>

          <h3 class="font-bold text-lg mt-6 mb-2">사이드 프로젝트</h3>
          <div class="flex flex-wrap gap-2 text-sm">
            {[
              { label: 'RS500 자율주행 시뮬 (ROS2·Gazebo)', href: `${base}cases/autonomy-stack/` },
              { label: 'hih-skills — 자동화 스킬 23개', href: 'https://github.com/hwanginhyeok' },
              { label: '인성이 — 블로그 자동화', href: `${base}cases/insung-blog/` },
              { label: '공학 지식 베이스 119노트', href: null },
            ].map((proj) => proj.href
              ? <a href={proj.href} class="bg-blue-50 px-3 py-1 rounded-full text-blue-600 hover:bg-blue-100">{proj.label}</a>
              : <span class="bg-blue-50 px-3 py-1 rounded-full text-blue-600">{proj.label}</span>
            )}
          </div>
        </div>

        <div>
          <h3 class="font-bold text-lg mb-3">기술 스택</h3>
          <div class="flex flex-wrap gap-2 text-sm">
            {skills.map((skill) => (
              <span class="bg-surface px-3 py-1 rounded-full text-muted">{skill}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-8 border-t border-ink-100 text-center text-sm text-muted">
      <p>황인혁 · 분야를 막론하고 — 문제가 있으면 해결한다</p>
      <p class="mt-1">
        <a href="https://github.com/hwanginhyeok" class="text-accent hover:underline" target="_blank" rel="noopener">GitHub</a>
      </p>
    </footer>

  </main>
</BaseLayout>
