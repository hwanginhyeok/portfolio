---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import stats from '../../../data/insung_stats.json';
const base = import.meta.env.BASE_URL;

// 서사 콘텐츠(problem/what/how)는 여기서 관리
// label/id/status는 stats.json에서 SSOT
const phases = [
  {
    problem: '이웃 댓글은 블로그 성장의 핵심이다. 그러나 하루 수십 개를 직접 달면 글 쓸 시간이 사라진다.',
    what: 'AI가 상대 블로그 글을 읽고 맥락에 맞는 댓글을 생성. 페르소나(말투·관심사)를 설정하면 일관된 목소리로 활동한다.',
    how: 'Claude Haiku · 페르소나 엔진 · 이웃 답방 스케줄러',
  },
  {
    problem: '글은 썼다. 그런데 네이버 스마트에디터에 올리는 과정이 또 시간을 잡아먹는다.',
    what: '사진과 메모만 전달하면 스마트에디터에 자동으로 발행한다. 블로거는 현장 경험에만 집중한다.',
    how: 'Playwright · 스마트에디터 DOM 자동화 · Telegram 트리거',
  },
  {
    problem: '자동화 시스템은 있는데, 핸드폰으로 상태를 보거나 조작할 방법이 없었다.',
    what: '텔레그램 하나로 시스템 전체를 제어한다. 이동 중에도 "지금 댓글 돌려"가 가능하다.',
    how: 'Telegram Bot API · Supabase 제어 평면 · FastAPI',
  },
  {
    problem: 'Playwright는 서버에서 네이버에 로그인한다. 네이버가 IP 이중접속을 탐지해 계정 위험이 생겼다.',
    what: '사용자 브라우저의 Chrome 확장이 직접 행동한다. 서버는 AI 생성과 DB만 담당. IP 문제 근본 해결.',
    how: 'Chrome Extension Manifest V3 · background.js · Vercel API Routes',
  },
];

const phasesWithMeta = phases.map((p, i) => ({
  ...p,
  num: stats.phases[i].id,
  label: stats.phases[i].label,
  status: stats.phases[i].status,
}));
---

<BaseLayout title="인성이 블로그 자동화 — 더 좋은 글을 위해">
  <main class="max-w-3xl mx-auto px-6 py-16">
    <a href={base} class="text-sm text-accent hover:underline mb-8 inline-block">← 홈으로</a>

    <span class="text-xs bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full font-medium">블로그 생태계</span>
    <h1 class="text-3xl font-black text-primary mt-3 mb-2 leading-tight">
      반복 노동을 제거하면<br />더 좋은 글이 나온다
    </h1>
    <p class="text-ink-500 mb-12 text-sm">네이버 블로그 체험단 자동화 시스템 — {stats.phase_count}단계 구축기</p>

    <!-- 철학 -->
    <section class="mb-14">
      <h2 class="text-xl font-black text-primary border-b border-ink-100 pb-2 mb-5">왜 만들었나</h2>
      <p class="text-sm text-ink-700 leading-relaxed mb-4">
        네이버 블로그 체험단 활동은 단순한 부업이 아니다.
        좋아하는 공간을 발견하고, 먹고 경험하고, 그것을 글로 남기는 일이다.
        자기만족이기도 하고, 그 글이 누군가에게 도움이 되기도 하고, 수익으로 이어지기도 한다.
      </p>
      <p class="text-sm text-ink-700 leading-relaxed mb-4">
        그런데 블로그 운영 시간의 상당 부분은 글 쓰는 것이 아니다.
        이웃 댓글 달기, 답방, 게시물 올리기 — 이 반복 노동이 "진짜 할 것"을 잠식한다.
      </p>
      <p class="text-sm font-semibold text-primary leading-relaxed">
        반복 노동을 시스템에 넘기면, 블로거는 더 많은 시간을 아날로그 경험과 글쓰기에 쓸 수 있다.
        더 좋은 글이 나오고, 생태계가 더 풍요로워진다.
      </p>
    </section>

    <!-- SS500과의 연결 — AI slop 패턴(colored left-border) 제거, 인용 스타일로 -->
    <section class="mb-14">
      <p class="text-xs font-semibold text-ink-500 uppercase tracking-widest mb-2">같은 철학, 다른 현장</p>
      <blockquote class="text-sm text-ink-700 italic bg-ink-100 rounded-lg px-5 py-4">
        SS500은 농부를 방제 노동에서 해방시킨다. 인성이 시스템은 블로거를 반복 디지털 노동에서 해방시킨다.
        <strong class="not-italic text-primary">자동화의 목적은 기술이 아니라 사람이 해야 할 것에 집중하게 하는 것이다.</strong>
      </blockquote>
    </section>

    <!-- 4단계 구축 -->
    <section class="mb-14">
      <h2 class="text-xl font-black text-primary border-b border-ink-100 pb-2 mb-8">{stats.phase_count}단계 구축</h2>

      <div class="space-y-10">
        {phasesWithMeta.map((p) => (
          <div class="relative pl-12">
            <!-- 단계 번호 원 -->
            <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-primary text-white text-sm font-black flex items-center justify-center shrink-0">
              {p.num}
            </div>
            <div>
              <!-- 라벨 배지 -->
              <span class="inline-block text-xs font-bold text-accent bg-accent/10 px-2 py-0.5 rounded-full mb-2 tracking-wide">
                {p.label}
              </span>
              <!-- 문제: h3보다 크고 명확한 스타일 -->
              <p class="font-bold text-primary text-base leading-snug mb-2">{p.problem}</p>
              <p class="text-sm text-ink-700 mb-1.5">{p.what}</p>
              <p class="text-xs text-ink-400 font-mono">{p.how}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 시스템 구조 — 다이어그램 이미지 삽입 (Fix 001) -->
    <section class="mb-14">
      <h2 class="text-xl font-black text-primary border-b border-ink-100 pb-2 mb-6">시스템 구조</h2>

      <!-- 블로거 플로우 요약 -->
      <div class="grid grid-cols-3 gap-2 text-center text-xs mb-6">
        {[
          { step: '01', label: '체험', sub: '카페·식당 방문' },
          { step: '02', label: '촬영', sub: '사진 찍기' },
          { step: '03', label: '전달', sub: '텔레그램으로' },
        ].map((s) => (
          <div class="bg-surface border border-ink-200 rounded-lg p-3">
            <div class="text-accent font-black text-lg">{s.step}</div>
            <div class="font-bold text-primary mt-0.5">{s.label}</div>
            <div class="text-ink-400 mt-0.5">{s.sub}</div>
          </div>
        ))}
      </div>
      <div class="text-center text-xs text-ink-400 mb-6">↓ 시스템이 처리</div>
      <div class="grid grid-cols-3 gap-2 text-center text-xs mb-8">
        {[
          { label: 'AI 글 초안', sub: 'Claude Haiku' },
          { label: '이웃 댓글', sub: '자동 생성·실행' },
          { label: '발행', sub: 'Chrome 확장' },
        ].map((s) => (
          <div class="bg-primary/5 border border-primary/10 rounded-lg p-3">
            <div class="w-1.5 h-1.5 rounded-full bg-accent mx-auto mb-2"></div>
            <div class="font-bold text-primary">{s.label}</div>
            <div class="text-ink-400 mt-0.5">{s.sub}</div>
          </div>
        ))}
      </div>

      <!-- 전체 구현 다이어그램 -->
      <figure class="border border-ink-200 rounded-xl overflow-hidden">
        <div class="bg-ink-100 px-4 py-2 text-xs text-ink-500 font-mono border-b border-ink-200">
          전체 시스템 구현 현황
        </div>
        <img
          src={`${base}images/cases/insung-blog/block_diagram.webp`}
          alt="인성이프로젝트 전체 시스템 구현 현황 다이어그램"
          class="w-full"
          loading="lazy"
        />
      </figure>
    </section>

    <!-- 기술 스택 — 칩 UI (Fix 003) -->
    <section class="mb-14">
      <h2 class="text-xl font-black text-primary border-b border-ink-100 pb-2 mb-5">기술 스택</h2>
      <div class="flex flex-wrap gap-2">
        {stats.tech_stack.map((t) => (
          <span class="text-xs px-3 py-1.5 bg-ink-100 text-ink-700 rounded-full font-medium border border-ink-200">
            {t}
          </span>
        ))}
      </div>
    </section>

    <!-- 현재 -->
    <section class="mb-14">
      <h2 class="text-xl font-black text-primary border-b border-ink-100 pb-2 mb-6">현재</h2>
      <div class="grid grid-cols-2 gap-3 text-center mb-6">
        <div class="bg-surface rounded-lg p-4 border border-ink-200">
          <div class="text-2xl font-black text-accent">{stats.phase_count}단계</div>
          <div class="text-xs text-muted mt-1">모두 완료 · 운영 중</div>
        </div>
        <div class="bg-surface rounded-lg p-4 border border-ink-200">
          <div class="text-2xl font-black text-accent">SaaS</div>
          <div class="text-xs text-muted mt-1">구독 모델 ({stats.subscription.basic}~)</div>
        </div>
      </div>
      <p class="text-sm text-ink-700 leading-relaxed">
        지금은 한 사람의 블로그를 위한 시스템이다. 앞으로는 체험단 활동을 하는 더 많은 블로거가
        반복 노동 없이 좋은 글을 쓸 수 있도록 넓혀가는 것이 목표다.
      </p>
    </section>

    <!-- 하단 네비 -->
    <div class="border-t border-ink-100 pt-8 flex justify-between text-sm">
      <a href={base} class="text-accent hover:underline">← 홈으로</a>
      <a href={`${base}#t5-roots`} class="text-accent hover:underline">엔지니어의 뿌리 →</a>
    </div>
  </main>
</BaseLayout>
