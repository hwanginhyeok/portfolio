---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

const phases = [
  {
    num: 1,
    label: '댓글봇',
    problem: '이웃 댓글은 블로그 성장의 핵심이다. 그러나 하루 수십 개를 직접 달면 글 쓸 시간이 사라진다.',
    what: 'AI가 상대 블로그 글을 읽고 맥락에 맞는 댓글을 생성. 페르소나(말투·관심사)를 설정하면 일관된 목소리로 활동한다.',
    how: 'Claude API · 페르소나 엔진 · 이웃 답방 스케줄러',
  },
  {
    num: 2,
    label: '발행봇',
    problem: '글은 썼다. 그런데 네이버 스마트에디터에 올리는 과정이 또 시간을 잡아먹는다.',
    what: '사진과 메모만 전달하면 스마트에디터에 자동으로 발행한다. 블로거는 현장 경험에만 집중한다.',
    how: 'Playwright · 스마트에디터 DOM 자동화 · 텔레그램 트리거',
  },
  {
    num: 3,
    label: 'Telegram 제어 평면',
    problem: '자동화 시스템은 있는데, 핸드폰으로 상태를 보거나 조작할 방법이 없었다.',
    what: '텔레그램 하나로 시스템 전체를 제어한다. 이동 중에도 "지금 댓글 돌려"가 가능하다.',
    how: 'Telegram Bot API · Supabase 제어 평면 · FastAPI',
  },
  {
    num: 4,
    label: 'Chrome 확장 전환',
    problem: 'Playwright는 서버에서 네이버에 로그인한다. 네이버가 IP 이중접속을 탐지해 계정 위험이 생겼다.',
    what: '사용자 브라우저의 Chrome 확장이 직접 행동한다. 서버는 AI 생성과 DB만 담당. IP 문제 근본 해결.',
    how: 'Chrome Extension (Manifest V3) · background.js · Vercel API Routes',
  },
];
---

<BaseLayout title="인성이 블로그 자동화 — 더 좋은 글을 위해">
  <main class="max-w-3xl mx-auto px-6 py-16">
    <a href={base} class="text-sm text-accent hover:underline mb-8 inline-block">← 홈으로</a>

    <span class="text-xs bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full">블로그 생태계</span>
    <h1 class="text-3xl font-black text-primary mt-2 mb-2">반복 노동을 제거하면<br />더 좋은 글이 나온다</h1>
    <p class="text-muted mb-10">네이버 블로그 체험단 자동화 시스템 — 4단계 구축기</p>

    <!-- 철학 -->
    <section class="mb-14">
      <div class="bg-surface rounded-xl p-6 border border-ink-300">
        <h2 class="text-base font-bold text-primary mb-3">왜 만들었나</h2>
        <p class="text-sm text-ink-700 leading-relaxed mb-4">
          네이버 블로그 체험단 활동은 단순한 부업이 아니다.
          좋아하는 공간을 발견하고, 먹고 경험하고, 그것을 글로 남기는 일이다.
          자기만족이기도 하고, 그 글이 누군가에게 도움이 되기도 하고, 수익으로 이어지기도 한다.
        </p>
        <p class="text-sm text-ink-700 leading-relaxed mb-4">
          그런데 블로그 운영 시간의 상당 부분은 글 쓰는 것이 아니다.
          이웃 댓글 달기, 답방, 게시물 올리기 — 이 반복 노동이 "진짜 할 것"을 잠식한다.
        </p>
        <p class="text-sm font-semibold text-primary leading-relaxed">
          반복 노동을 시스템에 넘기면, 블로거는 더 많은 시간을 아날로그 경험과 글쓰기에 쓸 수 있다.
          더 좋은 글이 나오고, 생태계가 더 풍요로워진다.
        </p>
      </div>
    </section>

    <!-- SS500과의 연결 -->
    <section class="mb-14">
      <div class="border-l-4 border-accent pl-4">
        <p class="text-xs text-ink-500 mb-1">같은 철학, 다른 현장</p>
        <p class="text-sm text-ink-700">
          SS500은 농부를 방제 노동에서 해방시킨다. 인성이 시스템은 블로거를 반복 디지털 노동에서 해방시킨다.
          <span class="font-semibold text-primary">자동화의 목적은 기술이 아니라 사람이 해야 할 것에 집중하게 하는 것이다.</span>
        </p>
      </div>
    </section>

    <!-- 4단계 구축 -->
    <section class="mb-14">
      <h2 class="text-xl font-black text-primary border-b border-ink-100 pb-2 mb-8">4단계 구축</h2>

      <div class="space-y-10">
        {phases.map((p) => (
          <div class="relative pl-10">
            <div class="absolute left-0 top-0 w-7 h-7 rounded-full bg-primary text-white text-xs font-bold flex items-center justify-center">
              {p.num}
            </div>
            <div>
              <span class="text-xs text-accent font-semibold uppercase tracking-wide">{p.label}</span>
              <h3 class="font-bold text-primary mt-0.5 mb-2">{p.problem}</h3>
              <p class="text-sm text-ink-700 mb-2">{p.what}</p>
              <p class="text-xs text-ink-500">{p.how}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 아키텍처 요약 -->
    <section class="mb-14">
      <h2 class="text-xl font-black text-primary border-b border-ink-100 pb-2 mb-6">시스템 구조</h2>
      <div class="bg-surface rounded-xl p-5 border border-ink-300 text-sm font-mono text-ink-700 leading-relaxed">
        <div class="mb-3">
          <span class="text-xs text-ink-500 block mb-1">블로거가 하는 것</span>
          <span class="text-primary font-semibold">체험 → 사진 촬영 → 텔레그램으로 전달</span>
        </div>
        <div class="border-t border-ink-200 pt-3 mb-3">
          <span class="text-xs text-ink-500 block mb-1">시스템이 하는 것</span>
          <span>AI 글 초안 생성 → Chrome 확장으로 발행</span><br/>
          <span>이웃 댓글 생성 → 스케줄 자동 실행</span><br/>
          <span>이웃 방문 · 답방 자동화</span>
        </div>
        <div class="border-t border-ink-200 pt-3">
          <span class="text-xs text-ink-500 block mb-1">인프라</span>
          <span class="text-xs">FastAPI · Supabase · Vercel · Chrome Extension (Manifest V3) · Telegram</span>
        </div>
      </div>
    </section>

    <!-- 현재 -->
    <section class="mb-14">
      <h2 class="text-xl font-black text-primary border-b border-ink-100 pb-2 mb-6">현재</h2>
      <div class="grid grid-cols-2 gap-3 text-center mb-6">
        <div class="bg-surface rounded-lg p-4 border border-ink-200">
          <div class="text-xl font-black text-accent">4단계</div>
          <div class="text-xs text-muted mt-1">모두 완료 · 운영 중</div>
        </div>
        <div class="bg-surface rounded-lg p-4 border border-ink-200">
          <div class="text-xl font-black text-accent">SaaS</div>
          <div class="text-xs text-muted mt-1">구독 모델 전환 (₩4,900~/월)</div>
        </div>
      </div>
      <p class="text-sm text-ink-700 leading-relaxed">
        지금은 한 사람의 블로그를 위한 시스템이다. 앞으로는 체험단 활동을 하는 더 많은 블로거가
        반복 노동 없이 좋은 글을 쓸 수 있도록 넓혀가는 것이 목표다.
      </p>
    </section>

    <!-- 하단 네비 -->
    <div class="border-t border-ink-100 pt-8 flex justify-between text-sm">
      <a href={base} class="text-accent hover:underline">← 홈으로</a>
      <a href={`${base}#t5-roots`} class="text-accent hover:underline">엔지니어의 뿌리 →</a>
    </div>
  </main>
</BaseLayout>
