---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StateMachine from '../../../components/StateMachine.astro';
import CanNetworkDiagram from '../../../components/CanNetworkDiagram.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="GT-SS500 — 전력제어 개발자가 제품을 양산까지 끌고 간다">
  <main class="max-w-3xl mx-auto px-6 py-16">
    <a href={base} class="text-sm text-accent hover:underline mb-8 inline-block">← 홈으로</a>

    <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full">GT-SS500</span>
    <h1 class="text-3xl font-black text-primary mt-2 mb-2">48V 전동 자율주행 방제기 — 전력제어 개발</h1>
    {/* 변경 2026-04-26: "CAN 10노드" → "CAN 5노드" (CONTENT_V2 §4.1/§7A.2 SSOT — VCU↔구동×2↔팬↔펌프↔BMS) */}
    <p class="text-muted mb-8">3kW BLDC ×2 · 48V LiFePO4 15S2P · CAN 5노드 · APQP 양산 체계</p>

    <!-- ─── 0. VCU 운전 상태머신 ─── -->
    <section class="space-y-6 mb-16">
      <h2 class="text-xl font-black text-primary border-b pb-2">0. VCU 운전 상태머신</h2>
      <p class="text-sm text-gray-600">하나의 VCU가 3가지 운전 모드(RC · LCD · ADT)를 관리한다. 모드 전환 시 반드시 Init 루틴(모든 모터 속도 0)을 거친다 — 안전 설계의 핵심.</p>

      <div class="border rounded-xl p-4 bg-white overflow-x-auto">
        <!-- Init -->
        <div class="flex justify-center mb-4">
          <div class="bg-gray-700 text-white rounded-lg px-4 py-2 text-center text-sm font-bold shadow">
            Init
            <div class="text-[10px] text-gray-300 font-normal mt-0.5">전원 ON · 페어링/조작 감지 대기</div>
          </div>
        </div>

        <!-- 화살표 + 라벨 -->
        <div class="flex justify-center items-center gap-8 mb-2 text-[10px] text-muted">
          <span>← RC 페어링</span>
          <span>↓ LCD 조작</span>
          <span>ADT 경로수신 →</span>
        </div>

        <!-- 3 운전 모드 -->
        <div class="grid grid-cols-3 gap-3 mb-4">
          <!-- RC 모드 -->
          <div class="border-l-4 border-blue-500 rounded-lg bg-blue-50 p-3">
            <div class="text-xs font-bold text-blue-700 mb-2">RC 모드 (리모콘)</div>
            <div class="space-y-1 text-[10px] text-gray-600">
              <div class="bg-white rounded px-2 py-1 border border-blue-200">RC_Ready</div>
              <div class="text-center text-muted">↓ 속도 지령</div>
              <div class="bg-white rounded px-2 py-1 border border-blue-200">RC_Drive</div>
              <div class="text-center text-muted">↓ 속도고정 ON</div>
              <div class="bg-white rounded px-2 py-1 border border-blue-200">RC_SpeedLock</div>
            </div>
          </div>

          <!-- LCD 모드 -->
          <div class="border-l-4 border-gray-500 rounded-lg bg-gray-50 p-3">
            <div class="text-xs font-bold text-gray-700 mb-2">LCD 모드 (설정)</div>
            <div class="space-y-1 text-[10px] text-gray-600">
              <div class="bg-white rounded px-2 py-1 border border-gray-200">LCD_Ready</div>
              <div class="text-center text-muted">↓ 파라미터 조정</div>
              <div class="bg-white rounded px-2 py-1 border border-gray-200">LCD_Setting</div>
            </div>
            <div class="mt-2 bg-yellow-50 border border-yellow-200 rounded px-2 py-1 text-[10px] text-yellow-700">
              속도 0 지속 인가 — 핵심 안전 설계
            </div>
          </div>

          <!-- ADT 모드 -->
          <div class="border-l-4 border-green-500 rounded-lg bg-green-50 p-3">
            <div class="text-xs font-bold text-green-700 mb-2">ADT 모드 (자율주행)</div>
            <div class="space-y-1 text-[10px] text-gray-600">
              <div class="bg-white rounded px-2 py-1 border border-green-200">ADT_Ready</div>
              <div class="text-center text-muted">↓ 경로 수신</div>
              <div class="bg-white rounded px-2 py-1 border border-green-200">ADT_Navigate</div>
              <div class="text-center text-muted">↕ 분사구간</div>
              <div class="bg-white rounded px-2 py-1 border border-green-200">ADT_Spray</div>
              <div class="text-center text-muted">↓ 약제부족/저전압</div>
              <div class="bg-white rounded px-2 py-1 border border-green-200">ADT_Return</div>
            </div>
          </div>
        </div>

        <!-- 모드 전환 -->
        <div class="bg-primary text-white rounded-lg px-4 py-2 text-center text-[11px] mb-4">
          모든 모드 간 전환 시: <strong>Init 루틴 실행 (모든 모터 속도 0)</strong>
        </div>

        <!-- Emergency + BumperStop -->
        <div class="grid grid-cols-2 gap-3">
          <div class="border-l-4 border-red-500 rounded-lg bg-red-50 p-3">
            <div class="text-xs font-bold text-red-700 mb-2">비상정지 (3모드 공통)</div>
            <div class="space-y-1 text-[10px] text-gray-600">
              <div class="flex items-center gap-1">
                <div class="bg-white rounded px-2 py-0.5 border border-red-200 flex-1 text-center">E_Stop</div>
                <span>→</span>
                <div class="bg-white rounded px-2 py-0.5 border border-red-200 flex-1 text-center">E_Alarm 5분</div>
                <span>→</span>
                <div class="bg-white rounded px-2 py-0.5 border border-red-200 flex-1 text-center">MR 차단</div>
              </div>
            </div>
            <div class="text-[10px] text-red-600 mt-1">해제 + 재시동 → Init 복귀</div>
          </div>

          <div class="border-l-4 border-orange-500 rounded-lg bg-orange-50 p-3">
            <div class="text-xs font-bold text-orange-700 mb-2">범퍼 정지 (ADT·RC)</div>
            <div class="space-y-1 text-[10px] text-gray-600">
              <div class="bg-white rounded px-2 py-0.5 border border-orange-200 text-center">B_Detect → B_Stop</div>
              <div class="text-[10px] text-gray-500 mt-1">0.05초 · 308A · <strong>정지거리 0.082m</strong> @3km/h</div>
              <div class="text-[10px] text-orange-600">전진/조향 불가 · 후진만 허용</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── 0b. CAN 네트워크 ─── -->
    <section class="space-y-4 mb-16">
      {/* 변경 2026-04-26: "6노드" → "5노드" (CONTENT_V2 §4.1/§7A.2 SSOT). 본문 5개와 일치 */}
      {/* 변경 2026-04-26: B1-15 — CanNetworkDiagram 컴포넌트로 메시지 흐름 시각화 추가 (표 위) */}
      <h2 class="text-xl font-black text-primary border-b pb-2">CAN 네트워크 — 5노드 메시지 구조</h2>
      <p class="text-sm text-gray-600">VCU가 CAN Bus 500kbps를 통해 5개 노드를 중재한다. 각 노드의 Tx/Rx 역할을 정확히 이해해야 제어 로직을 작성할 수 있다.</p>

      <CanNetworkDiagram />

      <div class="overflow-x-auto">
        <table class="w-full text-xs">
          <thead>
            <tr class="border-b text-left text-muted">
              <th class="pb-2 pr-3">노드</th>
              <th class="pb-2 pr-3">모듈</th>
              <th class="pb-2 pr-3">Tx (보내는 정보)</th>
              <th class="pb-2">Rx (받는 지령)</th>
            </tr>
          </thead>
          <tbody class="text-gray-700">
            <tr class="border-b border-gray-100">
              <td class="py-2 pr-3 font-bold">
                <span class="inline-block w-2 h-2 rounded-full bg-blue-500 mr-1"></span>VCU
              </td>
              <td class="py-2 pr-3 text-muted">STM32F479</td>
              <td class="py-2 pr-3">제어 지령 (속도·방향·분사)</td>
              <td class="py-2">모든 노드 상태 피드백</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2 pr-3 font-bold">
                <span class="inline-block w-2 h-2 rounded-full bg-red-500 mr-1"></span>BMS
              </td>
              <td class="py-2 pr-3 text-muted">48V 460Ah LiFePO4</td>
              <td class="py-2 pr-3">SOC · 셀전압 ×15 · 온도 · Warning/Fault</td>
              <td class="py-2">Shutdown 요청</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2 pr-3 font-bold">
                <span class="inline-block w-2 h-2 rounded-full bg-green-500 mr-1"></span>구동 MC ×2
              </td>
              <td class="py-2 pr-3 text-muted">DMKE 1226BL (CANopen)</td>
              <td class="py-2 pr-3">속도 FB · 전류 FB · 상태</td>
              <td class="py-2">속도 지령 · 방향 · 브레이크</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2 pr-3 font-bold">
                <span class="inline-block w-2 h-2 rounded-full bg-amber-500 mr-1"></span>팬 ESC
              </td>
              <td class="py-2 pr-3 text-muted">Hobbywing X6 (Extended 29bit)</td>
              <td class="py-2 pr-3">RPM · 온도</td>
              <td class="py-2">RPM 지령 (3단 속도)</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2 pr-3 font-bold">
                <span class="inline-block w-2 h-2 rounded-full bg-purple-500 mr-1"></span>펌프 DRV
              </td>
              <td class="py-2 pr-3 text-muted">48V DC</td>
              <td class="py-2 pr-3">압력 · 유량</td>
              <td class="py-2">구동 지령</td>
            </tr>
            <tr>
              <td class="py-2 pr-3 font-bold">
                <span class="inline-block w-2 h-2 rounded-full bg-orange-500 mr-1"></span>ADT PC
              </td>
              <td class="py-2 pr-3 text-muted">자율주행 컴퓨터</td>
              <td class="py-2 pr-3">경로 지령 · 목표 속도 · 모드 전환</td>
              <td class="py-2">차량 상태 (속도·SOC·Fault)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="bg-surface rounded-lg p-3 text-xs text-gray-600">
        DBC 기반 시그널 Factor/Offset 설정 · Little/Big Endian 처리 · 구동 MC는 CANopen 표준 · 팬 ESC는 Extended 29bit 프레임
      </div>
    </section>

    <!-- ─── 1. 핵심 제어 알고리즘 ─── -->
    <section class="space-y-6 mb-16">
      <h2 class="text-xl font-black text-primary border-b pb-2">1. 전력제어 핵심 알고리즘</h2>
      <p class="text-sm text-gray-600">3종 모터(구동 BLDC ×2, 팬 BLDC, 펌프 DC)와 솔밸브, 릴레이를 하나의 VCU(STM32F479)에서 제어한다. 안정 구동과 보호가 핵심.</p>

      <div class="space-y-6">
        <!-- F2: 과전류 보호 -->
        <div class="border-l-2 border-accent pl-4">
          <h3 class="font-bold text-primary">DC 과전류 보호</h3>
          <p class="text-sm text-gray-600 mt-1">MD2K 드라이버 CAN 피드백으로 DC 전류를 실시간 감시. <strong>70A 임계</strong> 초과 시 파워리밋 모드 진입 — 속도/듀티를 즉시 제한하여 드라이버·배터리 손상을 방지한다. VCU 소프트웨어 제한 + MD2K 하드웨어 보호의 <strong>이중 보호</strong> 구조.</p>
        </div>

        <!-- F3: 스톨 감지 -->
        <div class="border-l-2 border-accent pl-4">
          <h3 class="font-bold text-primary">스톨 감지 + 자동 복구</h3>
          <p class="text-sm text-gray-600 mt-1">목표 RPM 대비 실 RPM이 <strong>10% 미만인 상태가 2초</strong> 유지되면 스톨 판정. 장애물 걸림, 과부하 등에서 모터를 보호하고 5초 후 자동 복구를 시도한다.</p>
        </div>

        <!-- F4: 차동 조향 -->
        <div class="border-l-2 border-accent pl-4">
          <h3 class="font-bold text-primary">차동 조향 (Skid Steer)</h3>
          <p class="text-sm text-gray-600 mt-1">좌/우 구동모터를 <strong>독립 속도 제어</strong>하여 궤도식 차량을 조향. 4점 선형보간으로 조향 입력→좌우 속도비 변환. 내측 바퀴 최소 20%로 급회전 시 안정성 확보. 제자리 회전은 <strong>400rpm 별도 제한</strong>.</p>
          <p class="text-xs text-muted mt-1">RC: 조이스틱 조향 → VCU 보간 / ADT: 좌우 RPM 직접 지정 → VCU 조향 바이패스</p>
        </div>

        <!-- F7: 솔밸브 + 워터해머 -->
        <div class="border-l-2 border-accent pl-4">
          <h3 class="font-bold text-primary">분사 솔밸브 4ch + 워터해머 방지</h3>
          <p class="text-sm text-gray-600 mt-1">좌/우 × 상/하 <strong>4채널 독립 개폐</strong>로 분사 패턴 제어. 펌프 OFF 후 즉시 솔밸브를 닫으면 잔류 회전 중 압력 급상승(워터해머) 위험 — <strong>1.5초 딜레이 닫힘</strong>으로 잔압 해소 후 안전하게 차단.</p>
        </div>
      </div>

      <div class="bg-surface rounded-lg p-4 text-sm text-gray-600">
        <p class="font-bold text-primary mb-1">+ 기타 전력제어 알고리즘 개선</p>
        <p>PI 속도 제어기(Kp/Ki/Kc 튜닝), 속도 램프(1250rpm/s), 6등급 FaultReaction 체계(81 FC + 26 WC), 비상정지 이중경로(물리+RC), 충전 모드 자동 제한, Main Relay 7-state 상태머신, SOC 기반 자동 귀환/복귀 등 — 전력 시스템 전반의 안정 구동 로직을 분석·검증·개선.</p>
      </div>
    </section>

    <!-- ─── 2. 현장/제품 검토 문제점 해결 ─── -->
    <section class="space-y-6 mb-16">
      <h2 class="text-xl font-black text-primary border-b pb-2">2. 현장 이슈 해결</h2>
      <p class="text-sm text-gray-600 mb-4">알파/파일럿 차량에서 발생한 제어 로직 오류를 분석하고 수정.</p>

      <div class="space-y-4">
        <div class="bg-red-50 border border-red-200 rounded-lg p-3">
          <p class="text-sm font-bold text-red-600">솔레노이드 미해제 (FC47/FC72)</p>
          <p class="text-xs text-gray-600 mt-1">팬/펌프 고장 시 솔밸브가 안 닫힘 → AND 조건에 Fault 플래그 누락 발견. 약제 무압 누출 위험.</p>
        </div>
        <div class="bg-red-50 border border-red-200 rounded-lg p-3">
          <p class="text-sm font-bold text-red-600">Turn 속도 폭주 (#190)</p>
          <p class="text-xs text-gray-600 mt-1">ADT 제자리 Turn 시 400rpm 제한 초과(최대 2016rpm, 3.4배) → 상태전이 데드락 구조 발견 → State Diagnostic 로직 설계.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div class="border rounded-lg p-3">
            <p class="text-sm font-bold text-primary">제어권 전환 Init</p>
            <p class="text-xs text-gray-600 mt-1"><code>DM_INIT_DEBUG</code> 1줄 주석해제 → 모드 전환 시 잔존 속도 제거</p>
          </div>
          <div class="border rounded-lg p-3">
            <p class="text-sm font-bold text-primary">팬 2/3단 미동작</p>
            <p class="text-xs text-gray-600 mt-1">주석처리 + 변수 참조 오류 → 5줄 수정으로 해결</p>
          </div>
          <div class="border rounded-lg p-3">
            <p class="text-sm font-bold text-primary">부저 상시 울림</p>
            <p class="text-xs text-gray-600 mt-1">FAN 동작 시 ALARM persistent → 3파일 3단계 수정</p>
          </div>
          <div class="border rounded-lg p-3">
            <p class="text-sm font-bold text-primary">#define 코드리뷰</p>
            <p class="text-xs text-gray-600 mt-1">60파일, 매직넘버 90건, 즉시조치 3건(CRC 바이패스 등)</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── 3. 센서/페리퍼럴 설정 ─── -->
    <section class="space-y-6 mb-16">
      <h2 class="text-xl font-black text-primary border-b pb-2">3. 센서 구동 · 페리퍼럴 설정 · 물리값 스케일링</h2>
      <p class="text-sm text-gray-600 mb-4">SW팀이 드라이버 모듈을 만들면, 내가 <strong>물리값을 이해하고 파라미터를 설정</strong>한다. 데이터를 정확히 주고받아야 제어를 정확히 할 수 있다 — 이것이 전력제어 개발자의 핵심 역할.</p>

      <div class="overflow-x-auto">
        <table class="w-full text-xs">
          <thead>
            <tr class="border-b text-left text-muted">
              <th class="pb-2">페리퍼럴</th>
              <th class="pb-2">센서/모듈</th>
              <th class="pb-2">물리값 스케일링</th>
            </tr>
          </thead>
          <tbody class="text-gray-700">
            <tr class="border-b border-gray-100">
              <td class="py-2 font-bold">ADC (3ch)</td>
              <td>수위(정전용량 0-12V), 압력(0-5V), MR전압(47k:1k 분압)</td>
              <td>11점 보간(수위), LPF 0.05Hz, 48V→ADC 레인지 변환</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2 font-bold">DAC (1ch)</td>
              <td>펌프 속도 (PA4)</td>
              <td><code>V = Cmd×1.1 + 0.1</code> → 12bit 변환, 3단 매핑</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2 font-bold">TIM Input Capture</td>
              <td>펌프 고장검출 (PB6), 유량 펄스 (PA6)</td>
              <td>812mHz ±5% 주파수 판별 → 3-bit Fault 코드</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2 font-bold">CAN ×2</td>
              <td>구동(CANopen), 팬(Extended 29bit), BMS, LCD, ADT</td>
              <td>DBC 기반 시그널 Factor/Offset, Little/Big Endian</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2 font-bold">SPI (I2C2)</td>
              <td>TLE8110EE LSD 7ch 진단</td>
              <td>16bit 프레임 파이프라인, 5회 디바운스</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2 font-bold">UART</td>
              <td>S-Bus RC 수신기 (100kbps 8E2)</td>
