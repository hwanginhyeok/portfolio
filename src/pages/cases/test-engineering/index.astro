---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

const tests = [
  {
    phase: 'Phase 1 — 기초를 쌓다 (2023)',
    items: [
      {
        name: '다이나모미터 토크제어 시스템',
        what: 'Strain Gauge Full Bridge + Wheatstone Bridge 아날로그 처리 + 토크 컨트롤러 FW + 10포인트 교정',
        numbers: '비선형성 0.008% · 토크 감도 0.996 N·m · 사내 기술 세미나 개최',
        impact: '이후 EOP, ADT 모든 성능 시험의 표준 장비로 정착',
        image: 'PID_16.png',
        caption: 'PID 토크제어 파형 (16-step 오실로스코프)',
      },
    ],
  },
  {
    phase: 'Phase 2 — 방법론을 확장하다 (2024)',
    items: [
      {
        name: 'PWM 절환 온도 비교 시험',
        what: 'SVPWM vs DPWM 비교 프로토콜 · 55°/85°/120° 시험 매트릭스 · 실시간 CSV 로깅',
        numbers: '2,932개 데이터 포인트 · FET 온도 1~6°C 저감 · 12세트 비교',
        impact: '국책과제(EOP 400W) 완료보고서 핵심 근거',
        image: 'pwm-chart-120c-equilibrium.jpg',
        caption: '120°C 열평형 — 2,400초 steady-state FET 온도 모니터링',
      },
    ],
  },
  {
    phase: 'Phase 3 — 시스템으로 진화하다 (2025~2026, GT-SS500)',
    items: [
      {
        name: '펌프 성능평가 테스트베드',
        what: 'Blancett 유량계 + SENSYS 압력계 + 배관/밸브/탱크 · 단독 구축(ISSUE #126)',
        numbers: '3개 시료 비교(10.4/13.0/15.6 LPM) · 압력-유량 선형관계 규명',
        impact: '펌프 선정 의사결정 근거 — "감성 평가"에서 "데이터 기반 선정"으로',
        image: 'pump-bench-1.webp',
        caption: '펌프 성능평가 테스트베드 (유량계 + 압력계)',
      },
      {
        name: '팬 성능 개선 — 사내 벤치 → 공인 시험장 검증',
        what: '독립변수: 슈라우드 갭(45→9mm) · 통제변수: RPM 단수, 측정 위치 고정 · 사내(30cm 1포인트) → 농진원(14포인트 위치별)',
        numbers: '사내: 풍속 7.9→12.4 m/s(+57%) · 농진원: 14포인트 평균 +43~53% · 사각지대 5개→2개',
        impact: '사내 반복성 → 공인 재현성까지 계층적 검증. 설계 변경(모터 플레이트 4t→12t)의 정량적 근거',
        image: 'fan-bench-setup.webp',
        caption: '농진원 공인 시험장 — 14포인트 풍속 측정 셋업 (슈라우드 출구 L1~L7 / R1~R7)',
        image2: 'fan-bench-result.webp',
        caption2: '3단(30A) 위치별 풍속 개선량 — 전 단계 +43~53%, 사각지대 5개→2개',
      },
      {
        name: '범퍼 안전 시험',
        what: '6단계 이론 모델(v²/2a) + 범퍼 스트로크 123.5mm 기반 설계 + 실차 시험',
        numbers: '3km/h 정지거리 0.082m(이론 0.672m의 8배) · 피크 308A · 2km/h 정착 467ms',
        impact: '자율주행 안전 인증 핵심 데이터',
        image: null,
        caption: null,
      },
      {
        name: 'GT-SS500 vs 기성모델 성능 비교',
        what: '기성모델(한아 SS기) 실물 대여 · 노즐/펌프/팬 3대축 비교',
        numbers: '펌프 압력 GT-SS500 2배 · 유량 기성모델 4배 · 전자식 개별 제어 우위',
        impact: '제품 포지셔닝 및 업그레이드 방향 수립',
        image: 'nozzle-test-1.webp',
        caption: '노즐 분사 비교 시험 — GT-SS500 vs 기성모델',
      },
      {
        name: '내구성 시험 설계',
        what: '128,000 Cycle Kill Test 계획 · Worst Case 교반 Profile · 극한 조건 매트릭스',
        numbers: '온도(고/저) × 습도(고/건) × 지형(평/경사) 매트릭스',
        impact: '양산 품질 확보의 기초 — "프로토타입 동작"과 "양산품 3년 사용"의 차이',
        image: 'durability-before.webp',
        caption: '제품 — 신품 상태',
        image2: 'durability-after.jpg',
        caption2: '사이클 후 — 고무 트랙 마모/변형',
      },
    ],
  },
];
---

<BaseLayout title="시험 기획 7종 — 가설에서 데이터까지">
  <main class="max-w-3xl mx-auto px-6 py-16">
    <a href={base} class="text-sm text-accent hover:underline mb-8 inline-block">← 홈으로</a>

    <span class="text-xs bg-orange-100 text-orange-700 px-2 py-0.5 rounded-full">시험 기획</span>
    <h1 class="text-3xl font-black text-primary mt-2 mb-2">확인하고 싶으면 장비를 만들어서라도 본다</h1>
    <p class="text-muted mb-4">3년간 7개 시험 체계를 직접 설계·구축·운영</p>

    <!-- 반복 루프 다이어그램 -->
    <div class="bg-surface rounded-lg p-4 mb-12 text-sm text-center text-gray-600">
      가설 수립 → 측정 방법 설계 → 장비/벤치 구축 → 데이터 수집 → 정량적 결론 → 의사결정
    </div>

    {tests.map((phase) => (
      <section class="mb-12">
        <h2 class="text-lg font-bold text-primary mb-6 border-b pb-2">{phase.phase}</h2>

        <div class="space-y-10">
          {phase.items.map((item) => (
            <div class="border-l-2 border-accent pl-4">
              <h3 class="font-bold text-primary">{item.name}</h3>
              <p class="text-sm text-gray-600 mt-1">{item.what}</p>

              {item.image && !item.image2 && (
                <figure class="mt-3">
                  <img src={`${base}images/cases/test-engineering/${item.image}`} alt={item.name} class="rounded-lg border w-full" loading="lazy" />
                  <figcaption class="text-xs text-muted mt-1">{item.caption}</figcaption>
                </figure>
              )}
              {item.image && item.image2 && (
                <div class="grid grid-cols-2 gap-3 mt-3">
                  <figure>
                    <img src={`${base}images/cases/test-engineering/${item.image}`} alt={item.caption} class="rounded-lg border w-full" loading="lazy" />
                    <figcaption class="text-xs text-muted mt-1">{item.caption}</figcaption>
                  </figure>
                  <figure>
                    <img src={`${base}images/cases/test-engineering/${item.image2}`} alt={item.caption2} class="rounded-lg border w-full" loading="lazy" />
                    <figcaption class="text-xs text-muted mt-1">{item.caption2}</figcaption>
                  </figure>
                </div>
              )}

              <p class="text-sm mt-2">
                <span class="text-accent font-medium">수치: </span>
                <span class="text-gray-700">{item.numbers}</span>
              </p>
              <p class="text-sm mt-1">
                <span class="text-green-600 font-medium">임팩트: </span>
                <span class="text-gray-600">{item.impact}</span>
              </p>
            </div>
          ))}
        </div>
      </section>
    ))}

    <!-- 패턴 -->
    <section class="bg-primary text-white rounded-lg p-6 mb-12">
      <h2 class="font-bold mb-3">패턴 — 3년간의 진화</h2>
      <div class="text-sm space-y-2 text-gray-300">
        <p><strong class="text-blue-400">2023:</strong> 단일 장비 제작 (다이나모미터) → "만든 장비가 회사 인프라가 됨"</p>
        <p><strong class="text-blue-400">2024:</strong> 비교 시험 방법론 (PWM 온도) → "통제변수를 잠그고 Before/After를 숫자로"</p>
        <p><strong class="text-blue-400">2025~:</strong> 시스템 시험 체계 (펌프/팬/범퍼/내구/성능비교) → "제품 전체를 커버"</p>
      </div>
    </section>

    <div class="mt-12 flex justify-between">
      <a href={`${base}cases/eop-400w/`} class="text-sm text-accent hover:underline">← EOP 400W</a>
      <a href={`${base}cases/ss500-state-machine/`} class="text-sm text-accent hover:underline">상태머신 →</a>
    </div>
  </main>
</BaseLayout>
